#!/usr/bin/env python3
"""Cloud helper: use installed JDK and HTTPS proxy without storing credentials."""
import os, pathlib, subprocess, sys, urllib.parse
root=pathlib.Path(__file__).resolve().parents[1]
env=os.environ.copy()
jdk=pathlib.Path('/workspace/toolchains/jdk-21.0.6+7')
if jdk.exists():env['JAVA_HOME']=str(jdk)
env.setdefault('GRADLE_USER_HOME','/workspace/.gradle')
if pathlib.Path('/etc/ssl/certs/java/cacerts').exists():
    env['JAVA_TOOL_OPTIONS']=env.get('JAVA_TOOL_OPTIONS','')+' -Djavax.net.ssl.trustStore=/etc/ssl/certs/java/cacerts'
p=urllib.parse.urlparse(env.get('HTTPS_PROXY',env.get('https_proxy','')))
if p.hostname:
    if p.username:raise SystemExit('Authenticated proxy requires supported JVM authentication configuration.')
    env['JAVA_TOOL_OPTIONS']=env.get('JAVA_TOOL_OPTIONS','')+' -Dhttps.proxyHost='+p.hostname+' -Dhttps.proxyPort='+str(p.port or 80)+' -Dhttp.proxyHost='+p.hostname+' -Dhttp.proxyPort='+str(p.port or 80)+' -Dhttp.nonProxyHosts=localhost|127.*'
raise SystemExit(subprocess.call([str(root/'gradlew')]+sys.argv[1:],cwd=root,env=env))
